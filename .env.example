# PostgreSQL connection string (Neon recommended). Example:
# postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Random 32+ character secret used to sign session JWTs. Generate with:
# openssl rand -base64 32
JWT_SECRET=

# Groq API key for AI bio generation (server-side only, never exposed to the browser)
# https://console.groq.com
GROQ_API_KEY=

# Public base URL of the deployed app (used for NFC/QR links and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
